# Optional overrides for the prod environment. All non-secret defaults are
# baked into envs/prod/variables.tf, so this file is NOT required.
# Copy to terraform.tfvars (gitignored) and adjust if needed.

# bucket_name           = "vestio-assets"
# backend_instance_type = "t3.small"
# backend_max_capacity  = 4
# backend_image_tag     = "latest"

# HTTPS for the ALB. Leave unset for HTTP-only.
# acm_certificate_arn   = "arn:aws:acm:ca-central-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Set once the image-optimizer code repo pushes an image to ECR.
# image_optimizer_image_uri = "123456789012.dkr.ecr.ca-central-1.amazonaws.com/vestio/image-optimizer:latest"

# Widen if Spring Security rejects unauthenticated health probes.
# backend_health_check_matcher = "200-403"

# Non-secret container env (BUCKET_NAME and AWS_REGION are injected automatically).
# backend_environment = {
#   COGNITO_ISSUER_URI   = "https://cognito-idp.ca-central-1.amazonaws.com/<pool-id>/.well-known/openid-configuration"
#   COGNITO_JWK_SET_URI  = "https://cognito-idp.ca-central-1.amazonaws.com/<pool-id>/.well-known/jwks.json"
#   COGNITO_REGION       = "ca-central-1"
#   COGNITO_CLIENT_ID    = "..."
#   COGNITO_USER_POOL_ID = "ca-central-1_xxxxxxxxx"
#   SPRING_DATASOURCE_URL      = "jdbc:postgresql://<host>:5432/<db>"
#   SPRING_DATASOURCE_USERNAME = "..."
# }

# Secrets — NEVER commit. Prefer TF_VAR_backend_environment_sensitive in CI,
# or a gitignored terraform.tfvars.
# backend_environment_sensitive = {
#   SPRING_DATASOURCE_PASSWORD = "..."
#   COGNITO_CLIENT_SECRET      = "..."
# }
